# Netlify: block private/dev files from being served publicly.
# Netlify only supports "*" at the END of a path, so patterns like "/*.md" do not work:
# every private file is listed by name (tests/deploy-config.test.mjs checks none is missing).
/tests/*                  /404.html  404!
/functions/*              /404.html  404!
/netlify/*                /404.html  404!
/api/*                    /404.html  404!
/seed/*                   /404.html  404!
/netlify.toml             /404.html  404!
/server.js                /404.html  404!
/package.json             /404.html  404!
/package-lock.json        /404.html  404!
/Dockerfile               /404.html  404!
/vercel.json              /404.html  404!
/firebase.json            /404.html  404!
